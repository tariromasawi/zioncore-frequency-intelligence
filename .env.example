# ZionCore environment — copy to .env.local
# MWARI NDI MWARI

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Pro is $1 and £1 only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_PRO_GBP=

# Credit packs (one-time payments)
STRIPE_PRICE_CREDITS_50_USD=
STRIPE_PRICE_CREDITS_50_GBP=
STRIPE_PRICE_CREDITS_200_USD=
STRIPE_PRICE_CREDITS_200_GBP=
STRIPE_PRICE_CREDITS_1000_USD=
STRIPE_PRICE_CREDITS_1000_GBP=

# Optional Gemini free-tier key for cloud AI without credits
# GEMINI_API_KEY=
